{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cinema Reel collection",
  "type": "object",
  "required": [
    "site",
    "cards"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "site": {
      "type": "object",
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "collection": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loop": {
          "type": "boolean",
          "default": true
        },
        "scrollSensitivity": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 10,
          "default": 1,
          "description": "Scroll sensitivity"
        },
        "commitThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.16,
          "description": "Commit threshold"
        },
        "touchSensitivity": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 5,
          "default": 1.25,
          "description": "Touch sensitivity"
        },
        "touchThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.14,
          "description": "Touch threshold"
        },
        "wheelPauseMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000,
          "default": 20,
          "description": "Landing response"
        },
        "transitionMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "default": 320,
          "description": "Landing duration"
        },
        "easePower": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 20,
          "default": 3,
          "description": "Deceleration strength"
        },
        "gestureGapMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000,
          "default": 120,
          "description": "Gesture separation"
        },
        "textBlur": {
          "type": "number",
          "minimum": 0,
          "maximum": 256,
          "default": 32,
          "description": "Maximum text blur"
        },
        "textMotionBlur": {
          "type": "number",
          "minimum": 0,
          "maximum": 256,
          "default": 8,
          "description": "Blur while moving"
        },
        "textSharpnessMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000,
          "default": 120,
          "description": "Text clearing time"
        },
        "parallax": {
          "type": "number",
          "minimum": -1,
          "maximum": 2,
          "default": 0.83,
          "description": "Image parallax"
        },
        "imageEffect": {
          "enum": [
            "off",
            "blur",
            "frost"
          ],
          "default": "blur",
          "description": "Image treatment"
        },
        "imageBlur": {
          "type": "number",
          "minimum": 0,
          "maximum": 128,
          "default": 12,
          "description": "Image blur radius"
        },
        "imageIntensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 1,
          "description": "Effect intensity"
        },
        "imageClearMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000,
          "default": 160,
          "description": "Image clearing time"
        },
        "frostOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.16,
          "description": "Frost opacity"
        },
        "vignetteStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1,
          "description": "Edge vignette strength"
        },
        "vignetteDepth": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "default": 10,
          "description": "Edge vignette depth"
        },
        "cardGap": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "default": 5,
          "description": "Card spacing"
        },
        "cornerRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 200,
          "default": 28,
          "description": "Corner radius"
        }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "image"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "A unique lowercase slug."
          },
          "layout": {
            "enum": [
              "cinematic",
              "editorial"
            ],
            "default": "cinematic"
          },
          "title": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "One entry per title line. Use one or two short lines for the best composition."
          },
          "eyebrow": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "year": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "description": "A short introduction, especially useful in the editorial layout."
          },
          "credit": {
            "$ref": "#/$defs/fact"
          },
          "image": {
            "type": "object",
            "required": [
              "src",
              "alt"
            ],
            "additionalProperties": false,
            "properties": {
              "src": {
                "type": "string",
                "pattern": "^(/[^/]|https://)",
                "description": "Local /assets/ path or an HTTPS URL."
              },
              "alt": {
                "type": "string",
                "description": "A description of the photograph. Use empty text for purely decorative images."
              },
              "focus": {
                "type": "object",
                "required": [
                  "desktop"
                ],
                "additionalProperties": false,
                "properties": {
                  "desktop": {
                    "$ref": "#/$defs/focusPoint"
                  },
                  "mobile": {
                    "$ref": "#/$defs/focusPoint"
                  }
                },
                "description": "Image focal points as percentages. Mobile inherits desktop when omitted."
              },
              "overlay": {
                "$ref": "#/$defs/overlay"
              }
            }
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "quote"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "stars": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                }
              }
            }
          },
          "details": {
            "type": "object",
            "required": [
              "paragraphs"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "paragraphs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "facts": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/fact"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "focusPoint": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "gradientStop": {
      "type": "object",
      "required": [
        "position",
        "opacity"
      ],
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "linearGradient": {
      "type": "object",
      "required": [
        "angle",
        "stops"
      ],
      "additionalProperties": false,
      "properties": {
        "angle": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "stops": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/gradientStop"
          }
        }
      }
    },
    "radialGradient": {
      "type": "object",
      "required": [
        "centerX",
        "centerY",
        "width",
        "height",
        "clearUntil",
        "edgeOpacity"
      ],
      "additionalProperties": false,
      "properties": {
        "centerX": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "centerY": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 200
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 200
        },
        "clearUntil": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "edgeOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "overlayLayer": {
      "type": "object",
      "required": [
        "mode",
        "color",
        "linear",
        "radial"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "none",
            "linear",
            "radial",
            "both"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "linear": {
          "$ref": "#/$defs/linearGradient"
        },
        "radial": {
          "$ref": "#/$defs/radialGradient"
        }
      }
    },
    "overlay": {
      "type": "object",
      "required": [
        "mode",
        "color",
        "linear",
        "radial"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "none",
            "linear",
            "radial",
            "both"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "linear": {
          "$ref": "#/$defs/linearGradient"
        },
        "radial": {
          "$ref": "#/$defs/radialGradient"
        },
        "mobile": {
          "$ref": "#/$defs/overlayLayer"
        }
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "label",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
